{
  "name": "get2mars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5180 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "icons": "node scripts/make-icons.mjs",
    "ios": "npm run build && cap sync ios",
    "ios:open": "npm run ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource/press-start-2p": "^5.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3"
  }
}
